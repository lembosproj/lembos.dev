{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lembos.dev/schemas/events/dev.lembos.check.recovered.v1.json",
  "title": "dev.lembos.check.recovered",
  "description": "A check that had failed passes again. Version 1.",
  "type": "object",
  "properties": {
    "subject": {
      "description": "Something the event names: its entity type, its id, and what it was called when the event happened.",
      "type": "object",
      "properties": {
        "type": {
          "description": "The entity type, in the platform's kebab-case: component, resource, environment, release, execution-target, credential, blueprint, webhook.",
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "name"
      ]
    },
    "check": {
      "type": "string"
    },
    "scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "description": "The group that owns what the event is about.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "link": {
      "type": "string"
    }
  },
  "required": [
    "subject",
    "check",
    "scope",
    "owner",
    "link"
  ]
}
