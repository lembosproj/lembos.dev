<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>lembos-dev-apphost</UserSecretsId>
    <!-- As in the platform's AppHost: the SDK's own default, stated, with its warning taken. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.3" />
    <!--
    Nothing here references MessagePack. Aspire.Hosting 13.6.1 brings 2.5.302, which carries a known
    vulnerability (GHSA-qhrr-8q5h-9q3h); this lifts it to the patched line. Drop it once Aspire depends on
    a fixed version itself.
    -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

</Project>
